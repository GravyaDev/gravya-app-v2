{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/riferimenti-sola-lettura.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(~/Antigravity/gravya-app/**)",
      "Edit(~/Antigravity/gravya-app-kloudify/**)",
      "Write(~/Antigravity/gravya-app/**)",
      "Write(~/Antigravity/gravya-app-kloudify/**)"
    ]
  }
}
